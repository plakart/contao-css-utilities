parameters:
    level: 6
    phpVersion: 80400
    paths:
        - src
    ignoreErrors:
        -
            identifier: property.notFound
            message: '#^Access to an undefined property Contao\\LayoutModel::\$disableUtilityCss\.$#'
            paths:
                - src/EventListener/GeneratePageListener.php
                - src/EventListener/LayoutListener.php
        -
            # RecordLabel exists since Contao 6.0; the listener checks it with instanceof
            message: '#unknown class Contao\\CoreBundle\\DataContainer\\RecordLabel|Class Contao\\CoreBundle\\DataContainer\\RecordLabel not found#'
            path: src/EventListener/DataContainer/UtilityClassLabelListener.php
            reportUnmatched: false
